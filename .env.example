# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=dailyrace
POSTGRES_PASSWORD=dailyrace_dev
POSTGRES_DB=dailyrace
POSTGRES_EXTERNAL_PORT=5433

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001

# ── Google Auth ──────────────────────────────────────────────
# Modo: oauth (cuenta personal, dev) | service-account (produccion)
GOOGLE_AUTH_MODE=oauth

# OAuth (solo si GOOGLE_AUTH_MODE=oauth — obtener en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Service Account (solo si GOOGLE_AUTH_MODE=service-account — se inyectan via GitHub secrets)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Impersonation (emails que el service account puede impersonar, comma-separated)
GOOGLE_IMPERSONATE_EMAILS=

# ── Google Calendar / Meet ───────────────────────────────────
GOOGLE_CALENDAR_ID=primary
DAILY_MEETING_CODE=wye-iwfu-jch

# ── Notificaciones ───────────────────────────────────────────
# Selecciona el proveedor activo:
#   discord       solo Discord (default, estado historico)
#   google-chat   solo Google Chat App (Service Account + scope chat.bot)
#   dual          ambos a la vez (transicion)
NOTIFICATION_PROVIDER=discord

# ── Discord ──────────────────────────────────────────────────
# En dev usar SIEMPRE webhooks del canal de testing.
# Los webhooks reales solo se inyectan en produccion via GitHub secrets.
DISCORD_WEBHOOK_RACE_DAY=
DISCORD_WEBHOOK_CHAMPIONSHIP=

# ── Google Chat ──────────────────────────────────────────────
# Resource names de los spaces (formato: 'spaces/AAA...').
# Obligatorios cuando NOTIFICATION_PROVIDER es 'google-chat' o 'dual'.
# La SA debe tener scope 'https://www.googleapis.com/auth/chat.bot' autorizado por el admin.
# Ver docs/google-chat-setup.md para el setup completo.
GOOGLE_CHAT_SPACE_RACE_DAY=
GOOGLE_CHAT_SPACE_CHAMPIONSHIP=

# ── Meet Add-on (CORS) ───────────────────────────────────────
# Origenes permitidos para GET /api/live-race/current.
# Coma-separados. Ej: "https://daily-race.secture.com,https://localhost:3002"
# Si esta vacio, CORS queda deshabilitado.
LIVE_RACE_API_ALLOWED_ORIGINS=

# ── Timezone ─────────────────────────────────────────────────
TZ=Europe/Madrid
