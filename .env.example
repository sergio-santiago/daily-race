# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=dailyrace
POSTGRES_PASSWORD=dailyrace_dev
POSTGRES_DB=dailyrace
POSTGRES_EXTERNAL_PORT=5433

# Backend
NODE_ENV=development
BACKEND_PORT=3001

# Google Auth Mode: oauth (cuenta personal) | service-account (produccion)
GOOGLE_AUTH_MODE=oauth

# Google OAuth (cuenta personal — temporal hasta service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Service Account (produccion — cuando este disponible)
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Google Impersonation (organizers de los eventos de Calendar, comma-separated)
GOOGLE_IMPERSONATE_EMAILS=

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# Google Meet
DAILY_MEETING_CODE=wye-iwfu-jch

# Discord
DISCORD_WEBHOOK_RACE_DAY=
DISCORD_WEBHOOK_CHAMPIONSHIP=
DISCORD_WEBHOOK_RUINOTECA=

# Timezone
TZ=Europe/Madrid
