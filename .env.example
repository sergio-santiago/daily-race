GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Service Account (produccion — cuando este disponible)
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# Google Meet
DAILY_MEETING_CODE=wye-iwfu-jch

# Discord
