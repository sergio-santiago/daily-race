# Backend de Daily Race del que el add-on hace polling.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Cloud Project Number del proyecto GCP donde esta registrado el Meet Add-on.
NEXT_PUBLIC_MEET_CLOUD_PROJECT_NUMBER=

# Client ID de Google Identity Services para One Tap (V2).
# Obligatorio cuando se active la auth de usuario.
NEXT_PUBLIC_GIS_CLIENT_ID=
